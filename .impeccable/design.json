      "css": ".ds-navigation{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:0.875rem;padding:8px;background:linear-gradient(165deg,var(--navigation),var(--navigation-deep));color:var(--navigation-text);display:flex;flex-direction:column;gap:4px}.ds-destination{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:0.875rem;color:inherit;background:transparent;border:0;border-radius:12px;min-height:max(52px,calc(1.5em + 20px));padding:10px 12px;text-align:left;cursor:pointer}.ds-destination[aria-current]{background:var(--navigation-selection);font-weight:600;box-shadow:var(--shadow-control)}.ds-destination:hover{background:var(--navigation-selection)}.ds-destination:focus-visible{outline:2px solid var(--navigation-text);outline-offset:-3px}"
    },
    {
      "name": "Notice",
      "kind": "card",
      "refersTo": "notice",
      "description": "Quiet information adjacent to a task.",
      "html": "<div class=\"ds-notice\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 256 256\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"16\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"128\" cy=\"128\" r=\"96\"/><path d=\"M128 120v56m0-96v4\"/></svg><span>No files are scanned or changed.</span></div>",
      "css": ".ds-notice{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:0.875rem;display:flex;align-items:flex-start;gap:.75rem;padding:var(--space-medium);color:var(--secondary);background:var(--surface);border-radius:12px}.ds-notice svg{flex-shrink:0;margin-top:.0625rem}"
    },
    {
      "name": "Settings container",
      "kind": "card",
      "refersTo": "settings-card",
      "description": "Soft task grouping, not a row treatment.",
      "html": "<section class=\"ds-settings\"><h2>Appearance</h2><p>Choose how Reclaim looks on this Mac.</p></section>",
      "css": ".ds-settings{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:0.875rem;max-width:48rem;padding:var(--space-section);border-radius:var(--radius-panel);background:var(--surface);color:var(--text);box-shadow:var(--shadow-panel)}.ds-settings h2{margin:0;font-size:1.25rem;font-weight:600}.ds-settings p{margin:var(--space-small) 0 0;color:var(--secondary)}@media(max-width:760px){.ds-settings{padding:var(--space-large)}}"
    },
    {
      "name": "Appearance choice",
      "kind": "custom",
      "refersTo": "appearance-choice",
      "description": "Real radio control inside a selected warm wrapper.",
      "html": "<label class=\"ds-choice\"><input type=\"radio\" name=\"ds-appearance\" checked><span>System</span></label>",
      "css": ".ds-choice{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:0.875rem;display:inline-flex;gap:var(--space-small);align-items:center;min-height:2.75rem;min-width:8rem;border:1px solid var(--boundary);background:var(--surface);color:var(--text);border-radius:12px;padding:1rem;cursor:pointer;transition:background-color var(--duration-selection),color var(--duration-selection)}.ds-choice:has(input:checked){background:var(--selection);color:var(--selection-text);border-color:var(--accent)}.ds-choice:hover{background:var(--raised)}.ds-choice input{width:1rem;height:1rem;margin:0;accent-color:var(--accent)}.ds-choice input:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-choice{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Warm desktop investigation",
    "overview": "Warm plum navigation, lilac and peach atmosphere, creamy surfaces and a local sculptural folder make storage investigation approachable. Soft task framing surrounds readable controls and comparable rows; decoration yields to content when space is scarce.\n\nThis is a post-build record of the direct user-pinned warm desktop direction, superseding Space Layers. Runtime values belong to `src/shell/tokens.css`; this document records them, not a second runtime theme. The confirmed visual authority is [the warm reference packet](docs/design/warm-reference.md), with surface composition in [the shell contract](.impeccable/surfaces/application-shell.md).",
    "keyCharacteristics": [
      "Plum rail with persistent text labels.",
      "Warm light and dark surfaces with restrained soft depth.",
      "One original decorative object; crisp inspection rows.",
      "Content-first compact and enlarged-text reflow."
    ],
    "rules": [
      {
        "name": "The Warm Frame Rule",
        "body": "Use expressive gradients and depth for task framing; preserve crisp comparable rows for inspection.",
        "section": "colors"
      },
      {
        "name": "The Paired Theme Rule",
        "body": "Change semantic colors together through the runtime theme; dark appearance remains warm plum.",
        "section": "colors"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Use soft panel and control shadows to group and lift surfaces; keep result rows flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic runtime tokens and test both appearance modes.",
      "Do preserve text labels, visible focus, native form semantics and independent content scrolling.",
      "Do keep the original folder art local, decorative, proportional and optional at constrained widths.",
      "Do retain crisp table rows, selected-state contrast and tabular numerals."
    ],
    "donts": [
      "Don't ship competitor screenshots, symbols or branding as product assets.",
      "Don't fabricate scan metrics or use celebratory deletion motion.",
      "Don't turn each filename into a decorative card or let art block the action.",
      "Don't remove gradients, rounded surfaces or dimensional art merely to satisfy the superseded Space Layers direction."
    ]
  }
