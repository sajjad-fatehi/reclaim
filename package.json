{
  "name": "reclaim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "NODE_ENV=development tauri dev",
    "dev:web": "NODE_ENV=development vite",
    "build": "tauri build -- --locked",
    "build:web": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src index.html '*.json' '*.js' '*.ts' src-tauri/*.json src-tauri/capabilities/*.json && cargo fmt --all",
    "format:check": "prettier --check src index.html '*.json' '*.js' '*.ts' src-tauri/*.json src-tauri/capabilities/*.json && cargo fmt --all -- --check",
    "check:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "test": "NODE_ENV=test vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:rust && npm run test:rust",
    "test:rust": "cargo test --workspace --locked"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
